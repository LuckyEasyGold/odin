{
  "name": "odin",
  "version": "1.0.0",
  "description": "Open Document Infrastructure Network - Document automation platform",
  "author": "Vinícius Ramos <viniciusrinramos@gmail.com>",
  "license": "MIT",
  "private": true,
  "homepage": "https://codeberg.org/whodo/odin",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/whodo/odin.git"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @odin/api dev\" \"pnpm --filter @odin/web dev\"",
    "build": "pnpm -r run build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "lint": "biome lint .",
    "prepare": "husky",
    "postinstall": "pnpm --filter @odin/core build && pnpm --filter @odin/engine build && pnpm --filter @odin/storage build && prisma generate --schema=./packages/storage/prisma/schema.prisma"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "concurrently": "^8.2.0",
    "husky": "^9.0.0",
    "next": "15.0.0",
    "prisma": "5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "express": "^4.18.0"
  }
}
