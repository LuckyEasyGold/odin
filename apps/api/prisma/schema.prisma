generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  password  String?
  fullName  String?
  avatarUrl String?
  isSpecialist Boolean @default(false)
  specialty    String?
  registrationId String?
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  models    Model[]
  ratings   Rating[]
  apiKey    ApiKey[]
  webhooks  Webhook[]
  generations Generation[]
  transactions Transaction[]

  @@map("users")
}

model Model {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryName String?
  subcategory String?
  version     String
  template    String
  schema      Json
  fields      Json
  tags        String[]
  rating      Decimal  @default(0)
  ratingCount Int      @default(0)
  downloads   Int      @default(0)
  forks       Int      @default(0)
  license     String   @default("MIT")
  features    Json     @default("{}")
  compliance  Json     @default("{}")
  guidance    String?
  variableHints Json?
  price       Decimal  @default(0)
  isVerified  Boolean  @default(false)
  complianceScore Int  @default(0)
  curatorNote String?
  country     String   @default("BR")
  isPublic    Boolean  @default(true)
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  ratings     Rating[]
  generations Generation[]

  @@map("models")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String
  amount      Decimal
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model Rating {
  id        String   @id @default(uuid())
  modelId   String
  userId    String
  rating    Int      @default(3)
  comment   String?
  isTechnical Boolean @default(false)
  isApproval  Boolean @default(false)
  weight    Decimal  @default(1)
  createdAt DateTime @default(now())
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([modelId, userId])
  @@map("ratings")
}

model Generation {
  id          String   @id @default(uuid())
  modelId     String
  userId      String?
  inputs      Json
  outputHtml  String?
  outputPdfUrl String?
  outputJson  Json?
  documentHash String?
  externalSignatureId String?
  signatureStatus     String?
  signers             Signer[]
  status              String    @default("COMPLETED")
  signedAt            DateTime?
  ipAddress           String?
  createdAt   DateTime @default(now())
  model       Model    @relation(fields: [modelId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@map("generations")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  models      Model[]
  createdAt   DateTime   @default(now())

  @@map("categories")
}

model ApiKey {
  id               String   @id @default(uuid())
  userId           String
  name             String
  keyHash          String
  lastUsedAt       DateTime?
  rateLimitPerHour Int      @default(1000)
  createdAt        DateTime @default(now())
  isActive         Boolean  @default(true)
  user             User     @relation(fields: [userId], references: [id])

  @@map("api_keys")
}
model Webhook {
  id         String   @id @default(uuid())
  userId     String
  url        String
  events     String[]
  secret     String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@map("webhooks")
}

model Signer {
  id           String     @id @default(uuid())
  generationId String
  email        String
  name         String
  status       String     @default("PENDING")
  order        Int        @default(0)
  signatureId  String?
  signedAt     DateTime?
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@map("signers")
}