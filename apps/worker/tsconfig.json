{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "./dist",
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@odin/core": ["../../packages/core/src/index.ts"],
      "@odin/engine": ["../../packages/engine/src/index.ts"]
    },
    "rootDirs": ["./src", "../../packages/core/src", "../../packages/engine/src"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
