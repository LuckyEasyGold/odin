generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  password  String?
  fullName  String?
  avatarUrl String?
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  models    Model[]
  ratings   Rating[]
  apiKey    ApiKey[]
  generations Generation[]
  transactions Transaction[]

  @@map("users")
}

model Model {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryName String? // Legacy field for backup
  subcategory String?
  version     String
  template    String
  schema      Json
  fields      Json
  tags        String[]
  rating      Decimal  @default(0)
  ratingCount Int      @default(0)
  downloads   Int      @default(0)
  forks       Int      @default(0)
  price       Decimal  @default(0)
  license     String   @default("MIT")
  features    Json     @default("{}")
  compliance  Json     @default("{}")
  isPublic    Boolean  @default(true) // New visibility field
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  ratings     Rating[]
  generations Generation[]

  @@map("models")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "CREDIT" (purchase), "DEBIT" (usage), "EARNING" (royalties)
  amount      Decimal
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model Rating {
  id        String   @id @default(uuid())
  modelId   String
  userId    String
  rating    Int      @default(3)
  comment   String?
  weight    Decimal  @default(1)
  createdAt DateTime @default(now())
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([modelId, userId])
  @@map("ratings")
}

model Generation {
  id          String   @id @default(uuid())
  modelId     String
  userId      String?
  inputs      Json
  outputHtml  String?
  outputPdfUrl String?
  outputJson  Json?
  documentHash String?  // SHA-256 DNA
  status      String   @default("COMPLETED") // PENDING_SIGNATURE, SIGNED, COMPLETED
  signedAt    DateTime?
  ipAddress   String?
  createdAt   DateTime @default(now())
  model       Model    @relation(fields: [modelId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@map("generations")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  models      Model[]
  createdAt   DateTime   @default(now())

  @@map("categories")
}

model ApiKey {
  id               String   @id @default(uuid())
  userId           String
  name             String
  keyHash          String
  lastUsedAt       DateTime?
  rateLimitPerHour Int      @default(1000)
  createdAt        DateTime @default(now())
  isActive         Boolean  @default(true)
  user             User     @relation(fields: [userId], references: [id])

  @@map("api_keys")
}