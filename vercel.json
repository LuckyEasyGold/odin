{
  "version": 2,
  "functions": {
    "apps/api/src/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/apps/api/src/index.ts"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/apps/api/src/index.ts"
    }
  ]
}
