{
  "version": 2,
  "functions": {
    "apps/api/src/index.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/apps/api/src/index.ts"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "/apps/api/src/index.ts"
    }
  ]
}
